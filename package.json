{
  "name": "the-first-move",
  "private": true,
  "version": "2.1.0",
  "description": "قدم اول — یک روز معمولی دانشگاه، با خط داستانی برگهٔ چاپی، محیط دانشگاهی پرجزئیات و اجرای مستقیم از GitHub Pages",
  "type": "module",
  "homepage": "https://axiasoft.github.io/Ghadam-Aval/",
  "scripts": {
    "generate:assets": "node scripts/generateGlbAssets.mjs",
    "generate:music": "python3 scripts/generateMusicTracks.py",
    "generate:sfx": "python3 scripts/generateSfxTracks.py",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "typecheck": "tsc -b",
    "pages:build": "vite build && node scripts/finalizePages.mjs",
    "build": "tsc -b && vite build && node scripts/finalizePages.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.66.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright": "^1.64.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
